[Unit]
Description=G560 Linux Utility ambient lighting for Bazzite Gaming Mode
After=pipewire.service gamescope-session-plus@steam.service
PartOf=gamescope-session-plus@steam.service
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=%h/Documents/G560 Linux Utility/target/release/logig560 run-gaming
Restart=on-failure
RestartSec=2s
TimeoutStopSec=10s

[Install]
WantedBy=gamescope-session-plus@steam.service
