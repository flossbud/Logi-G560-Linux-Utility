{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "G560 Linux Utility",
  "version": "0.1.0",
  "identifier": "com.logig560.gui",
  "build": {
    "frontendDist": "./ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "G560 Linux Utility",
        "width": 1080,
        "height": 720,
        "minWidth": 920,
        "minHeight": 640,
        "decorations": true,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
